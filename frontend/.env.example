# Production API URL (Absolute URL to backend for decoupled setups, e.g. https://api.yourdomain.com/api/v1)
VITE_API_URL=https://api.your-backend-server.com/api/v1

# Supabase Configuration (Matching values used in the backend setup)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
